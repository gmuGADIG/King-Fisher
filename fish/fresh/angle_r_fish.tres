[resource]
script = ExtResource("1_0vayt")
fish_name = "Angle-r Fish"
grade = 2
sprite = ExtResource("2_8w4m7")
description = "The Angle-r fish is quite a rare fish to catch! Angle-r fishes are commonly known for their isolation and calculated and intelligent personality, only traveling in the ocean within its vertices in acute, right, and obtuse angles, calculating which space to move in to be completely safe. However, when feeling threatened, this smart little fish quickly calculates the best angle of escape and travels in straight, reflex, and full angles to confuse any lurking predators then makes a quick escape. Only the smartest fishers could catch this one needing intensive knowledge in geometry. First you must use “brain food” such as leafy greens, berries, or nuts and seeds as bait, as the Angle-r fish will be drawn to it, then you must know your geometry relationships, knowing complementary, supplementary, adjacent, and vertical angles to perfectly calculate the degree where your fishing rod should land! If you caught this fish, bravo to you! Eating one is reported to make you feel like your brain grew three times that day. (Only one recorded case of hospitalization due to this!) "
metadata/_custom_type_script = "uid://cr3nmjdvpgh0a"
