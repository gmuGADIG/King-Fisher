[resource]
script = ExtResource("1_36r1s")
fish_name = "Lovers Fish"
grade = 2
sprite = ExtResource("2_bliok")
description = "It’s hard to find love in the waters of Pollywood. In this day and age it’s hard for fish to meet other decent fish! What with the unrealistic expectations brought about by fishmedia, the paradox of dating webnets! Oh the horrors… However… These two fish have overcome the odds and found their one true love for life! This male has found his lover and has latched onto her to fuse with her permanently. Their bond is a permanent one. Together they are Bonnie and Clyde! Or Antony and Cleopatra! Or Romeo and Juliet! Because in this bond once the female dies so does the other…"
metadata/_custom_type_script = "uid://cr3nmjdvpgh0a"
