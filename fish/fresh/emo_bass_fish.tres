[resource]
script = ExtResource("1_d6l1x")
fish_name = "Emo Bass Fish"
grade = 2
sprite = ExtResource("2_mafcq")
description = "This peculiar specimen rejected its colorful green roots in favor of everything dark and artificial. It sports an edgy hairstyle, makeup, and accessories of its own design, showing its strong personality and commitment to uniqueness.
It sports strong vocal cords and a naturally wide-open mouth that lends it naturally to singing. So, feeling misunderstood by the fish around it, it started a band of other ostracized fish, and they took the seas by storm with their powerful sound waves. They called themselves a new generation of life on the seafloor—not living in sand, but in hard rock.
Everyone thought that Emo’s bass playing was the toughest around. You’d never catch it without its instrument. However, one day, in a tragic accident, the rest of its band members were lost to the dreaded Thrasher Shark, and were never seen again. After that, Emo Bass became a recluse, writing sad songs and poetry to stave off the cut that never healed."
metadata/_custom_type_script = "uid://cr3nmjdvpgh0a"
