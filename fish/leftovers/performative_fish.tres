[resource]
script = ExtResource("1_s6gv3")
fish_name = "Fish Team Fish"
grade = 1
sprite = ExtResource("2_6xbey")
description = "An Amethyst Anthias fish was used as the basis for a scientific experiment. The experiments intended to create a fish that would become the perfect mate for any female fish.

However, the lead scientist was arrested for smelting live Gold Fish and turning them into a set of armor.

Because of this, a young, newer scientist took over the experiment. Due to his inexperience, he messed up the last step of the experiment, and everything went wrong.
The Amethyst Anthias changed, he did not become the most desired fish in the sea, instead, he became something... horrifying. He started reading feminist literature, he started drinking matcha tea, he started wearing quarter-zip sweaters, and he carried all of it in his special tote bag.

The group of scientists immediately attempted to exterminate the fish, but driven by his desire to get a girlfriend, he escaped.

It has not been seen since the incident."
metadata/_custom_type_script = "uid://cr3nmjdvpgh0a"
