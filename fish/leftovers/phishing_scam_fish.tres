[resource]
script = ExtResource("1_1y1v2")
fish_name = "Phishing Scam"
grade = 1
sprite = ExtResource("2_mcp5t")
description = "As of a recent marketing campaign for the Intergalactic Fishbowl, there was an attempt at incorporating third-party advertisements that would be holographically casted onto the tournament playgrounds for spectators to see during matches. Unfortunately, this plan was cut short as hosts realized that the technology required to cast these advertisements were quite harmful for the fishing water, leading to many of the fish found in tournaments mimicking several not-so-family-friendly products and websites. While they mostly serve as a PR concern for the tournament, they also serve as a genuine danger to the fishing area that it occupies. Phishing Scams have an infectious quality to them, baiting in other fish and turning other fish into a Phishing Scam once they come into physical contact with one another. Due to this, F.I.S.H.E. has made several attempts to rollback on these holographic advertisements, but the damage was already done. Phishing Scams can still be found scattered throughout the land, although they fortunately serve no harm to the fishers who catch them. In fact, you’d be doing the waters a great service in catching one."
metadata/_custom_type_script = "uid://cr3nmjdvpgh0a"
