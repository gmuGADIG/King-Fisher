[resource]
script = ExtResource("1_vgim8")
fish_name = "British Fish"
grade = 1
sprite = ExtResource("2_c6gco")
description = "The British fish is a genetically altered variant of the standard fish species that populates the ponds and lakes of Pollywood. This species originally had a handful of them stolen by British insurgents and then took them to their home base in London to paint them with the british flag colors

They then returned the painted variant and then sneakily placed them back into the ponds, specifically in densely populated areas. The fish then populated with the other fish, and to everyone’s surprise, the British flag colors were fully imprinted on the progeny. Like they were pure blooded.

The British fish tends to feast on anything that tastes similar to tea and crackers. Just don't ask them about weetbix.... 
"
metadata/_custom_type_script = "uid://cr3nmjdvpgh0a"
