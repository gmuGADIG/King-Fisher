[resource]
script = ExtResource("1_7fhri")
fish_name = "Steven"
grade = 1
sprite = ExtResource("2_grt4b")
description = "Hey, dude! I'm Steven! I don't really know how I got here, honestly. I remember coming out here just to dip my toes in the water, then all of a sudden I'm getting pulled up by you! Fascinating how this world works, huh? Anyways, I'm sure you were probably tryna catch a fish out there, aren't ya? Oh, sorry for getting in the way, friend. You seem like quite an experienced fisher, though. I mean, you were able to catch little ol' me! Hehe! I bet the next time you throw out that line of yours you'll catch a REAAAAAL big one. Yeah, I'm sure you will. Y'know, I used to be a fisher myself! Back in the old days, me and my pals would come out here and spend the whole night just fishin' to our hearts content. I miss those days, to be honest with ya. Maybe after I get off of this hook of yours, I might pick up the ol' fishing rod again. What do you think? Think I should get back to the fishin' waters? Ah, who am I kiddin', I should decide for myself. It's just so hard to choose! I mean, I've been real relaxed this last week, but I still got that itch, yknow? Quite the conundrum we got on our hands...Oh, sorry, I'm rambling again. Just go ahead and let me down, why don't ya? Good luck fishing out there! I'm sure you don't need it though. My name's Steven in case you forgot!"
metadata/_custom_type_script = "uid://cr3nmjdvpgh0a"
