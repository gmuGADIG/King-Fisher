[resource]
script = ExtResource("1_kmn0e")
fish_name = "Sasha Splash"
grade = 3
sprite = ExtResource("2_h2nc2")
catch_blurb = "Bubble your troubles and take your troubles to the trash and splash around the dance floor!"
description = "This species of fish was bred by the late and great drag queen Sasha Splash for her iconic wet and bubbly FishTalk performance. She was also known for her other performances of fishing attitudes and ballet in the water. Both of which involved Sasha taking the time to “swim with the fishes” as her introductory skit where she highlights one of the local fishes in the area. There are no records of what Sasha used to bred the fish as she was notoriously known to be a bit of a meanie. Due to this selfish nature, we can only guess what was spliced and mated in order to create such a glistening specimen. On top of that because of an unforeseen event Sasha drowned during her first performance. Her in-laws, seeing no reason to keep the fish, let them out into the wild. Due to their flawless glitter techniques and bombastic side-eyed looks, the fish was able to slay out in the wild. Even though it is a rare species to come by. It felt wrong to call the fish anything other than by their creator and also because of licensing agreements with Sasha Splash relatives. To finish of the entry, a famous Sasha Splash that the team thought best fit the fishes: “Bubble your troubles and take your troubles to the trash and splash around the dance floor!” "
metadata/_custom_type_script = "uid://cr3nmjdvpgh0a"
