[resource]
script = ExtResource("1_7pln3")
fish_name = "Fish Seven"
grade = 4
sprite = ExtResource("2_5bht5")
description = "Known for it being the 7th classified fish to originate from the planet, its less-than-interesting title was assigned purely out spite from the Intergalactic Fishbowl organizers, as this fish is the most annoying catch in the land. Fish Seven is quite the noise maker, frantically flapping its fins up and down, constantly splashing the water everywhere it goes. Its agitating noise makes the fish’s presence known to all fishers in its proximity, ruining the originally peaceful atmosphere of whatever body of water it ends up on. Not a single fisher enjoys catching one, and will actively leave their fishing zone if they dare catch their sights on one. Despite its grating presence, there is a younger generation of fishers that have seem to grown a liking to the creature, although it is unclear if this growth in interest is from pure irony or not. Nonetheless, it holds quite the status, whether for better or for worse."
metadata/_custom_type_script = "uid://cr3nmjdvpgh0a"
