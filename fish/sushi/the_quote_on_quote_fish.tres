[resource]
script = ExtResource("1_d4ets")
fish_name = "The \"Fish\""
grade = 4
sprite = ExtResource("2_8xyq2")
catch_blurb = "This one seems a little fishy..."
description = "Quite a mysterious catch, and an even more mysterious creature in the lab. While this simple-looking fish exhibits all of the external traits of a common fish, research has unearthed conflicting information on the inside. No matter how many tests are conducted, there is not a single other known fish that shares its biological makeup. Findings support that this particular species of fish belongs to an entirely distinct branch of evolution—even then, nobody has discovered where this branch lies. 

Due to these factors, this species can only be properly classified in the wild using a high-expense scientific analysis (which is indeed siphoned from the Intergalactic Fishbowl’s budget each time the fish is caught in tournament waters). This, combined with how many research grants have been completely burned just to arrive at a name for this species, has kept the true nature of this species locked behind an enormous paywall. While it's not an incredibly rare find in the water, it holds infamy as nature's grandest mystery."
metadata/_custom_type_script = "uid://cr3nmjdvpgh0a"
